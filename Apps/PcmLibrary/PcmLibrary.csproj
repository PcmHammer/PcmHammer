<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>PcmHacking</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.0.0.0</Version>
    <!-- Keep the informational/product version clean (e.g. 2.0.0.0) instead of
         "2.0.0.0+<gitsha>", which the SDK adds by default for SDK-style projects. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>PCM Library</Title>
    <Authors>PCM Hacking</Authors>
    <Company>PcmHacking.net</Company>
    <Copyright>2018-2026 PcmHacking.Net</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://PcmHammer.org</PackageProjectUrl>
    <PackageReleaseNotes>This is an untested experiment. You almost certainly don't want to use it.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logging\MathValueConfiguration.cs" />
    <Compile Remove="Module.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="System.Xml.XmlSerializer" />
  </ItemGroup>

</Project>
