<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>PCMLoggerAvalonia</RootNamespace>
		<!-- net10.0 drives the desktop heads; net10.0-android lets the logger run on a phone. On the
		     android target, TargetPlatformIdentifier == 'android', so the Windows-only device layer
		     (J2534DotNet, PcmLibraryWindowsApi) is excluded below and an Android device path is used. -->
		<TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<!-- The logging parameter database: the shared ParameterDatabase loads these from the app's base
	     directory (AppContext.BaseDirectory), as WinForms/PcmLogger does. Linked and copied so they
	     land next to the exe without a second copy in the tree. -->
	<ItemGroup>
		<Content Include="..\..\WindowsForms\PcmLogger\Parameters*.xml">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Trouble-code descriptions: the shared DiagnosticCodeDefinitions.Load reads this beside the
		     exe (AppContext.BaseDirectory), as WinForms/PcmLogger does. -->
		<Content Include="..\..\WindowsForms\PcmLogger\DiagnosticCodes.txt">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- The default log profile, loaded on connect so a sensible set of PIDs is pre-selected
		     (the WinForms logger starts with a default list too). Copied beside the exe. -->
		<Content Include="DefaultProfiles\Overview.LogProfile">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="FluentAvaloniaUI" />
	</ItemGroup>

	<PropertyGroup>
		<!-- J2534DotNet and PcmLibraryWindowsApi multi-target net48;net10.0-windows and resolve via the
		     net48 fallback on non-Windows builds (NU1702). Their Windows-only P/Invokes have no Linux
		     equivalent, so on Linux builds define LINUX_CLI to compile out any Windows-only call sites in
		     this project, matching the pattern used by PcmLibraryWindowsApi, the CLI and PCMHammerAvalonia. -->
		<DefineConstants Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('linux'))">$(DefineConstants);LINUX_CLI</DefineConstants>
	</PropertyGroup>

	<!-- Cross-platform reference: always included (the shared logging engine lives here). -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\PcmLibrary\PcmLibrary.csproj" />
	</ItemGroup>

	<!-- Device/transport layer: the serial path is used on Linux; J2534 is present but unused there.
	     Excluded on Android, which has no net48 Windows API: the Android device path (serial IPort +
	     DeviceFactory) lives in Platforms/Android instead. -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'android'">
		<ProjectReference Include="..\..\..\J2534DotNet\J2534DotNet\J2534DotNet.csproj" />
		<ProjectReference Include="..\..\..\PcmLibraryWindowsApi\PcmLibraryWindowsApi.csproj" />
	</ItemGroup>

	<!-- Android device path: serial over System.IO.Ports (the Platforms/Android shims), and the
	     desktop-only, Windows-typed device picker dialog is left out of the Android build. -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
		<PackageReference Include="System.IO.Ports" />
		<Compile Remove="Views\DeviceSelectDialog.axaml.cs" />
		<AvaloniaXaml Remove="Views\DeviceSelectDialog.axaml" />
	</ItemGroup>
</Project>
