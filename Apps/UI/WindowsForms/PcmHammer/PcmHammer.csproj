    <Reference Include="netstandard" />
    <!-- These legacy (non-SDK) projects do not flow direct PackageReference compile
         assemblies into the build under "dotnet build" (only assemblies coming transitively
         through ProjectReferences do). PcmHammer's own code/resources compile directly against
         CommandLineParser and System.Resources.Extensions, so reference them explicitly via the
         restored package path (GeneratePathProperty). They remain PackageReferences below so
         restore still downloads and version-pins them, and Costura embeds the copied assembly. -->
    <Reference Include="CommandLine">
      <HintPath>$(PkgCommandLineParser)\lib\netstandard2.0\CommandLine.dll</HintPath>
    </Reference>
    <!-- Binary .resx resources are written with PreserializedResourceWriter (CI sets
         GenerateResourceUsePreserializedResources=true), which needs System.Resources.Extensions
         at build and run time. On net48 the SDK's conflict resolution strips the package's copy
         from references (it is on the framework-provided list, but net48 does not actually ship
         it), so reference the restored package assembly explicitly via its GeneratePathProperty
         path - an explicit primary reference survives conflict resolution and is copied/embedded. -->
    <Reference Include="System.Resources.Extensions">
      <HintPath>$(PkgSystem_Resources_Extensions)\lib\net462\System.Resources.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.8.0" GeneratePathProperty="true" />
    <PackageReference Include="System.IO.Ports" Version="10.0.5" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" GeneratePathProperty="true" />
