<Page x:Class="PcmHacking.UnoUI.Presentation.VinChangePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PcmHacking.UnoUI.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" x:Name="OldVinLabel" />
            <RowDefinition Height="*" x:Name="OldVinValue" />
            <RowDefinition Height="*" x:Name="OldVinStatus" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="*" x:Name="NewVinLabel" />
            <RowDefinition Height="*" x:Name="NewVinValue" />
            <RowDefinition Height="*" x:Name="NewVinStatus" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="*" x:Name="UpdateVinButton" />
            <RowDefinition Height="*" x:Name="UpdateVinStatus" /> 
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0"
            Text="Current VIN:"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="5" />

        <TextBlock Grid.Row="1"
            Text="{Binding OldVin}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="5" />
        
        <TextBlock Grid.Row="2"
            Text="{Binding OldVinStatus}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="5" />


        <TextBlock Grid.Row="4"
            Text="New VIN:"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="8" />

        <TextBox Grid.Row="5"
            Text="{Binding NewVin, Mode=TwoWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="5" />

        <TextBlock Grid.Row="6"
            Text="{Binding NewVinStatus}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="5" />

        <Button Grid.Row="8"
            Content="Update VIN"
            IsEnabled="{Binding UpdateButtonEnabled}"
            Command="{Binding UpdateVin}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="5" />

        <TextBlock Grid.Row="9"
            Text="{Binding UpdateVinStatus}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="5" />

    </Grid>
</Page>
