<Page x:Class="PcmHacking.UnoUI.Presentation.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PcmHacking.UnoUI.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopButtons"/>
            <RowDefinition x:Name="MessageRow1"/>
            <RowDefinition x:Name="MessageRow2"/>
            <RowDefinition x:Name="BottomButtons"/>
            <RowDefinition x:Name="CopyrightRow" Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" 
              Content="Go To PcmHacking.net"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="SettingsPageButton"
              Command="{Binding OpenForum}" />

        <Button Grid.Row="0" Grid.Column="1" 
              Content="Go To GitHub.com/PcmHammer"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="WritePcmButton"
              Command="{Binding OpenGitHub}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Text="{Binding Message}"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              HorizontalTextAlignment="Center"
              />

        <HyperlinkButton 
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Visibility="{Binding LinkVisibility}"
            NavigateUri="{Binding Link}"
            Content="{Binding LinkText}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Top"
            />

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
            Content="View Debug Log"
            Margin="10"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.AutomationId="LogButton"
            Command="{Binding GoToLog}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
            Text="Copyright (C) 2018-2026 PcmHacking.net - GPL v3"
            Margin="10,4,10,10"
            HorizontalAlignment="Center"
            HorizontalTextAlignment="Center"
            FontSize="12"
            Opacity="0.6" />
    </Grid>
</Page>
