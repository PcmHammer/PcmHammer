<Page x:Class="PcmHacking.UnoUI.Presentation.DataLoggingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PcmHacking.UnoUI.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

    <Button Grid.Row="0" Grid.Column="0" 
              Content="New Profile"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="NewProfileButton"
              Command="{Binding NewProfileClicked}" />

    <Button Grid.Row="1" Grid.Column="0" 
              Content="Open Profile"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="OpenProfileButton"
              Command="{Binding OpenProfileClicked}" />

    <Button Grid.Row="2" Grid.Column="0" 
              Content="Save Profile"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="SaveButton"
              IsEnabled="{Binding SaveButtonEnabled}"
              Command="{Binding SaveProfileClicked}" />

    <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="Recent Files" 
            HorizontalAlignment="Center" 
            Margin="10"/>
        
        <ListView 
            Grid.Row="1"
            Grid.Column="0"            
            Name="RecentFiles" 
            ItemsSource="{Binding RecentFiles}"
            IsDoubleTapEnabled="true"
            Tapped="RecentFiles_Tapped"
            DoubleTapped="RecentFiles_DoubleTapped" 
            PreviewKeyDown="ListView_KeyDown"
            IsTabStop="true">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="8">
                        <TextBlock Text="{Binding FileName}" FontSize="20" />
                        <TextBlock Text="{Binding Location}" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

    <Button Grid.Row="2" Grid.Column="1"
              Content="Save Profile As..."
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="SaveAsButton"
              IsEnabled="{Binding SaveAsButtonEnabled}"
              Command="{Binding SaveProfileAsClicked}" />

  </Grid>
</Page>
