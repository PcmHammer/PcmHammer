<Page x:Class="PcmHacking.UnoUI.Presentation.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PcmHacking.UnoUI.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      >
  <ScrollViewer>
    <Grid utu:SafeArea.Insets="VisibleBounds">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopButtons"/>
        <RowDefinition x:Name="MiddleButtons"/>
        <RowDefinition x:Name="BottomButtons"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <Button Grid.Row="0" Grid.Column="0" 
              Content="Settings"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="SettingsPageButton"
              Command="{Binding GoToSettings}" />

      <Button Grid.Row="0" Grid.Column="1" 
              Content="Write PCM"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="WritePcmButton"
              Command="{Binding GoToWrite}" />

      <Button Grid.Row="1" Grid.Column="0"
              Content="Other Functions"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="OtherFunctionsButton"
              Command="{Binding GoToOtherFunctions}" />

      <Button Grid.Row="1" Grid.Column="1"
              Content="Test Write"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"                            
              AutomationProperties.AutomationId="ReadPcmButton"
              Command="{Binding GoToTestWrite}" />

      <Button Grid.Row="2" Grid.Column="0"
              Content="Help"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"              
              AutomationProperties.AutomationId="HelpButton"
              Command="{Binding GoToHelp}" />

      <Button Grid.Row="2" Grid.Column="1"
              Content="Data Logging"
              Margin="10"
              Padding="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"                            
              AutomationProperties.AutomationId="DataLoggingButton"
              Command="{Binding GoToDataLogging}" />

    </Grid>
  </ScrollViewer>
</Page>
