<ContentDialog x:Class="PcmHacking.UnoUI.Presentation.DataLoggingEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PcmHacking.UnoUI.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Loaded="ContentDialog_Loaded"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Width="500" Height="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" x:Name="Label1" />
            <RowDefinition Height="*" x:Name="Label2" />
            <RowDefinition Height="*" x:Name="Label3" />
            <RowDefinition Height="4*" x:Name="UpperHalf" />
            <RowDefinition Height="4*" x:Name="LowerHalf" />
            <RowDefinition Height="*" x:Name="Whitespace" />
            <RowDefinition Height="*" x:Name="Buttons" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="{Binding Prompt}"
                   Margin="10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Parameter"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="5" />

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Text="Units"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="5" />

        <TextBox Grid.Row="2"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Name="Filter"
                 Width="200"
                 TextChanged="TextBox_TextChanged"
                 PlaceholderText="Filter..."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="5" />

        <ListView Grid.Row="3"
                  Grid.RowSpan="2"
                  Grid.Column="0"   
                  Grid.ColumnSpan="2"
                  Name="Parameters"
                  ItemsSource="{Binding ParameterList}"
                  Margin="5" />
        
        <ListView Grid.Row="3"
                  Grid.Column="2"
                  Name="Conversions"
                  ItemsSource="{Binding ConversionList}"
                  Margin="5" />

        <CheckBox 
                  Grid.Row="4"
                  Grid.Column="2"
                  Content="Zoom"
                  IsChecked="{Binding Zoom}"
                  Margin="5" />

        <Button Grid.Row="6"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding DeleteButtonVisibility}"
                Margin="5" 
                Width="150"
                Content="Delete Parameter" 
                Click="Delete_Clicked" />
        
        <Button Grid.Row="6"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="5" 
                Width="150"
                Content="Apply Changes" 
                Click="Apply_Clicked"/>

        <Button Grid.Row="6"
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="5" 
                Width="150"
                Content="Cancel" 
                Click="Cancel_Clicked"/>
    </Grid>
</ContentDialog>
