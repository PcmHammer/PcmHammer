<Page
    x:Class="PcmHacking.UnoUI.Presentation.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PcmHacking.UnoUI.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utu="using:Uno.Toolkit.UI"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="60" x:Name="Navigation"/>
      <RowDefinition Height="*" x:Name="EverythingElse"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <local:CommonTopBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

    <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
      <TextBlock TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords" 
                 Text="Do you have a serial, or J2534 interface?"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <RadioButton Content="Serial" IsChecked="{Binding Path=UseSerialDevice, Mode=TwoWay}"  Margin="0,0,20,0"/>
        <RadioButton Content="J2534" IsChecked="{Binding Path=UseJ2534Device}" />
      </StackPanel>
      <TextBlock Visibility="{Binding Path=UseSerialDevice}" TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords" Margin="0,20,0,0"
                 Text="Which sort of OBD2 device do you have?" />
      <ListView Visibility="{Binding Path=UseSerialDevice}" ItemsSource="{Binding SerialDeviceTypes}" BorderThickness="1" />
      <TextBlock Visibility="{Binding Path=UseSerialDevice}" TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords" Margin="0,20,0,0"
                 Text="Which COM port does your OBD2 device use?" />
      <ListView  Visibility="{Binding Path=UseSerialDevice}" ItemsSource="{Binding Obd2Ports}" BorderThickness="1" />
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
      <TextBlock TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords"
                 Text="Do you have a SeeedStudio USB-CAN analyzer for aftermarket CAN sensors?"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <RadioButton Content="Yes" IsChecked="{Binding Path=UseCanDevice, Mode=TwoWay}" Margin="0,0,20,0"/>
        <RadioButton Content="No" IsChecked="{Binding Path=DontUseCanDevice}"/>
      </StackPanel>

      <TextBlock Visibility="{Binding Path=UseCanDevice}" TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords" Margin="0,20,0,0"
                 Text="Which COM port does your SeeedStudio USB-CAN analyzer use?" />
      <ListView Visibility="{Binding Path=UseCanDevice}" ItemsSource="{Binding CanPorts}" BorderThickness="1" />
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10">
      <TextBlock TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="WrapWholeWords"
                 Text="Where shall we save your data logs?" />
      <TextBlock TextAlignment="Center" Margin="10" Text="{Binding DataLogFolder}" />
      <Button HorizontalAlignment="Center" Margin="10" Content="Change Folder" Command="{Binding OpenLogFolderPicker}"/>
      <Button HorizontalAlignment="Center" Margin="10" Content="Open Folder" Command="{Binding OpenLogFolder}"/>
    </StackPanel>

  </Grid>
</Page>
