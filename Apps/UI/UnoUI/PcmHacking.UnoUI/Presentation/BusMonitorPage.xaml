<Page
    x:Class="PcmHacking.UnoUI.Presentation.BusMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PcmHacking.UnoUI.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utu="using:Uno.Toolkit.UI"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="ProtocolRow" />
            <RowDefinition Height="Auto" x:Name="ButtonsRow" />
            <RowDefinition Height="Auto" x:Name="StatusRow" />
            <RowDefinition Height="*" x:Name="TrafficRow" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- A radio pair rather than a list, to match the WinForms monitor. Each is disabled when the
             connected interface cannot watch that bus. -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Bus:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton Content="VPW"
                         IsChecked="{Binding UseVpw}"
                         IsEnabled="{Binding VpwBusAvailable}" />
            <RadioButton Content="CAN 500k"
                         IsChecked="{Binding UseCan, Mode=TwoWay}"
                         IsEnabled="{Binding CanBusAvailable}"
                         Margin="16,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="CAN IDs:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding CanFilter, Mode=TwoWay}"
                     IsEnabled="{Binding UseCan}"
                     MinWidth="180" />
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="0" Margin="10" Padding="10"
                HorizontalAlignment="Stretch"
                Content="{Binding StartStopButtonText}"
                Command="{Binding StartStop}" />

        <Button Grid.Row="1" Grid.Column="1" Margin="10" Padding="10"
                HorizontalAlignment="Stretch"
                Content="Clear"
                Command="{Binding Clear}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                   Text="{Binding Status}" TextWrapping="WrapWholeWords" />

        <ScrollViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <TextBlock Margin="10" FontFamily="Courier New" Text="{Binding Traffic}" />
        </ScrollViewer>
    </Grid>
</Page>
