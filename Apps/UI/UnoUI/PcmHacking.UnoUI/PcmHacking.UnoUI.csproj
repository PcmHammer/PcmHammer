<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-android;net10.0;</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!--
      NU1702: J2534DotNet and PcmLibraryWindowsApi target net48;net10.0-windows, so a reference from
      net10.0-desktop or plain net10.0 falls back to the net48 build and NuGet warns that it may not
      be fully compatible.

      Expected and accepted. J2534 is a Windows driver model - the libraries P/Invoke into vendor
      DLLs - and net10.0-desktop cannot match net10.0-windows, so there is no target that resolves
      cleanly while keeping the J2534 support those heads need. The alternative, adding a plain
      net10.0 target to both of those projects, buys nothing: they would still only work on Windows.
    -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>PCMHammer.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>net.PCMHammer.Uno</ApplicationId>
    <!-- Versions -->
    <Version>0.0.0.0</Version>
    <ApplicationDisplayVersion>0.0.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Keep the informational/product version clean (e.g. 2.0.0.0) instead of "2.0.0.0+<gitsha>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>PcmHacking.net</ApplicationPublisher>
    <!-- Package Description -->
    <Description>PCMHammer.Uno powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Localization;
      Navigation;
      ThemeService;
      Storage;
    </UnoFeatures>
    <!-- Same icon as the WinForms and WPF front ends, shared from Apps\UI\Shared so there is one copy.
         Sets the icon on the Windows apphost; the other heads use their own asset pipelines. -->
    <ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">..\..\Shared\0411_256px.ico</ApplicationIcon>

    <!-- The generated launcher icon's foreground. Overriding the Uno.Sdk property replaces the stock
         Uno logo; adding a UnoIcon item instead only adds a second icon, leaving the default in place.
         The SDK's per-platform ForegroundScale (0.65 on Android) keeps it inside the adaptive-icon
         safe zone. The file is named pcmhammer.png because Uno.Resizetizer rejects names that do not
         start with a letter. -->
    <UnoIconForegroundFile>Assets\Icons\pcmhammer.png</UnoIconForegroundFile>

    <!-- Splash screen. The stock asset is the Uno logo on white; use the same image as the launcher
         icon, on the app's own dark page background (ApplicationPageBackgroundThemeBrush in dark
         mode), so the launch does not flash white. Uno generates a single uno_splash_color with no
         values-night variant, so this one colour applies in both system themes. The image is a copy
         of the icon's, not the same file: Uno.Resizetizer rejects a splash that shares a path with
         UnoIcon.ForegroundFile. -->
    <UnoSplashScreenFile>Assets\Splash\pcmhammer_splash.png</UnoSplashScreenFile>
    <UnoSplashScreenColor>#202020</UnoSplashScreenColor>

    <PackageCertificateThumbprint>E9055ABE166B5A0901A78706D44BBCA8573A5143</PackageCertificateThumbprint>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <!-- API 31 (Android 12): the floor is arbitrary, so pick the one that costs no compatibility code.
         The BLUETOOTH_SCAN/ADVERTISE/CONNECT permissions arrive here, so there is no legacy Bluetooth
         path to carry; MANAGE_EXTERNAL_STORAGE (API 30) is already below it. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.1</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.1</TargetPlatformMinVersion>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x86</RuntimeIdentifiers>
    <!-- Pin the Windows head to a 32-bit apphost so the process can load 32-bit J2534 driver DLLs
         (a 64-bit process cannot). Without this, an AnyCPU/default build produces a 64-bit apphost;
         setting the RID here makes 32-bit the default, not only the explicit x86 build. -->
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x86</RuntimeIdentifier>
    <PlatformTarget Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">x86</PlatformTarget>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectCapability Include="Maui" />
  </ItemGroup>  

  <PropertyGroup Condition="'$(Configuration)'=='Debug' or '$(IsUiAutomationMappingEnabled)'=='True'">
    <IsUiAutomationMappingEnabled>True</IsUiAutomationMappingEnabled>
    <DefineConstants>$(DefineConstants);USE_UITESTS</DefineConstants>
  </PropertyGroup>  

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.0</TargetFrameworks>
    <Platforms Condition="$([MSBuild]::IsOSPlatform('windows'))">x86</Platforms>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!--
    Release publish of the Windows head is one self-contained .exe, with the kernels beside it as the
    only loose files. Scoped to Release so the Debug build keeps its ordinary folder layout.

    Everything is embedded: the .NET runtime, the Windows App SDK (WindowsAppSDKSelfContained) and the
    native libraries, which the host extracts to a temp folder on first run. Symbols are embedded
    rather than emitted as .pdb files beside the exe, which keeps the single-file promise without
    giving up line numbers in a stack trace - this app's field diagnosis depends on those.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The three below are what Microsoft.WindowsAppSDK.SingleFile.targets requires; without them it
         either errors out or warns that the packed app will not find its runtime:
         EnableMsixTooling for the embedded resources.pri, IncludeAllContentForSelfExtract for the DLL
         side-by-side redirection, and UndockedRegFreeWinRTInitialize to set
         MICROSOFT_WINDOWSAPPRUNTIME_BASE_DIRECTORY before the program starts. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <DebugType>embedded</DebugType>
    <!-- English only; the stock set emits ~90 satellite folders that survive as empty directories. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Referenced projects otherwise drop their .pdb and .xml beside the exe, which is most of what
         is left in the publish folder once everything else is packed in. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- Not trimmed. Uno.Extensions resolves navigation, DI and configuration by reflection and the
         app serializes settings with System.Text.Json, none of which the trimmer can see: a trimmed
         publish of this head has failed at startup with a TypeLoadException before. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    The kernels are the one thing kept outside the exe, so they can be replaced without a rebuild.
    ExcludeFromSingleFile is needed because the Windows App SDK's single-file support requires
    IncludeAllContentForSelfExtract, which would otherwise pack them in with everything else.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="..\..\..\..\Kernels\build\*.bin" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

