<Application x:Class="PCMHammer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCMHammer"
             xmlns:helpers="clr-namespace:PCMHammer.Helpers"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibility" />
            <helpers:NullToBooleanConverter x:Key="NullToBoolean" />
            <helpers:InverseBooleanConverter x:Key="InverseBoolean" />
            <helpers:HexStringToIntegerConverter x:Key="HexConverter" />
            <helpers:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />

            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LockoutProgress, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Value" From="1.0" To="0.0" Duration="0:0:30" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
