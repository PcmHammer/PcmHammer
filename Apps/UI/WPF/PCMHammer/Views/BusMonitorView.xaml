<UserControl x:Class="PCMHammer.Views.BusMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:PCMHammer.Helpers"
             xmlns:viewmodels="clr-namespace:PCMHammer.Viewmodels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:BusMonitorViewModel}"
             d:DesignHeight="420" d:DesignWidth="600">
    <Grid Margin="4" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
            <TextBlock Text="Protocol:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton Content="VPW" GroupName="MonitorProtocol" VerticalAlignment="Center" Margin="0,0,12,0"
                         IsChecked="{Binding IsCanSelected, Converter={StaticResource InverseBoolean}}"
                         IsEnabled="{Binding IsVpwSelectable}"/>
            <RadioButton Content="CAN 500k" GroupName="MonitorProtocol" VerticalAlignment="Center" Margin="0,0,20,0"
                         IsChecked="{Binding IsCanSelected}"
                         IsEnabled="{Binding IsCanSelectable}"/>
            <TextBlock Text="CAN IDs:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="150" VerticalAlignment="Center"
                     Text="{Binding CanFilterText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsFilterEnabled}"
                     ToolTip="Hex CAN ids to show, separated by spaces. Leave empty to show every id."/>
        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Width="74"/>
            <Button Content="Clear" Command="{Binding ClearLogCommand}" Width="74" Margin="6,0,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="MonitorLogTextBox" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"
                 helpers:LogTextBoxBehavior.Source="{Binding Lines}"/>
    </Grid>
</UserControl>
