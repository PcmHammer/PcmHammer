<UserControl x:Class="PCMHammer.Views.TuneEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PCMHammer.Views">
<UserControl.Resources>
 <Style x:Key="RibbonGroup" TargetType="StackPanel"><Setter Property="Margin" Value="12,5"/></Style>
 <Style x:Key="RibbonCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#60788D"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
 <Style x:Key="AreaList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="AreaItem" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="AreaItem" Property="Background" Value="#C6ECEB"/><Setter Property="Foreground" Value="#0E555C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AreaItem" Property="Background" Value="#DFEEF1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style></Setter.Value></Setter>
 </Style>
</UserControl.Resources>
<Grid Margin="10,6" Background="#EEF3F8">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="2,0,2,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CALIBRATION" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding TuneIdentity}" Foreground="#60788D" FontSize="11" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="{Binding TuneIdentity}"/></Grid>
 <TabControl Grid.Row="1" Background="White" BorderBrush="#D4DFE9" Padding="0" Margin="0,0,0,5">
  <TabItem Header="Home"><DockPanel LastChildFill="False" Height="64" Background="White">
   <StackPanel DockPanel.Dock="Left" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal"><Button Content="BIN + XDF…" Command="{Binding OpenXdfPairCommand}" Background="#29D6CB" BorderBrush="#159D99" Margin="0,0,5,0"/><Button Content="Example" Command="{Binding LoadSparkExampleCommand}" ToolTip="Open a synthetic spark-table example; no vehicle calibration"/></StackPanel><TextBlock Text="OPEN WORKSPACE" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <Border DockPanel.Dock="Left" Width="1" Background="#E0E7EE" Margin="0,8"/>
   <StackPanel DockPanel.Dock="Left" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding SelectionTools}" SelectedItem="{Binding SelectedTool}" Width="167" VerticalContentAlignment="Center" IsEnabled="{Binding CanEdit}" ToolTip="{Binding ToolHint}"/><TextBox Text="{Binding ToolAmount,UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="5,0" VerticalContentAlignment="Center" ToolTip="Amount or percentage"/><Button Content="Apply" Command="{Binding ApplySelectionToolCommand}" IsEnabled="{Binding CanApplyTool}"/></StackPanel><TextBlock Text="{Binding SelectionStatus}" Style="{StaticResource RibbonCaption}" ToolTip="{Binding ToolHint}"/></StackPanel>
   <Border DockPanel.Dock="Left" Width="1" Background="#E0E7EE" Margin="0,8"/>
   <StackPanel DockPanel.Dock="Left" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal"><Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,5,0"/><Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,5,0"/><Button Content="Save cells" Command="{Binding CommitCellsCommand}" IsEnabled="{Binding CanEdit}" ToolTip="Validate typed cells and update the graph; does not program the ECU"/></StackPanel><TextBlock Text="EDIT HISTORY" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <Border DockPanel.Dock="Left" Width="1" Background="#E0E7EE" Margin="0,8"/>
   <StackPanel DockPanel.Dock="Left" Style="{StaticResource RibbonGroup}"><ComboBox ItemsSource="{Binding WorkspaceLayouts}" SelectedItem="{Binding SelectedLayout}" Width="135" Height="32" VerticalContentAlignment="Center"/><TextBlock Text="WORKSPACE VIEW" Style="{StaticResource RibbonCaption}"/></StackPanel>
  </DockPanel></TabItem>
  <TabItem Header="Files &amp; vehicle"><WrapPanel Height="64" Background="White">
   <StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Open BIN + XDF…" Command="{Binding OpenXdfPairCommand}"/><TextBlock Text="REFERENCE PRACTICE" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Native definition…" Command="{Binding LoadDefinitionCommand}"/><TextBlock Text="CHECKED NATIVE DEFINITIONS" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Apply to loaded tune" Command="{Binding ApplyToTuneCommand}" IsEnabled="{Binding CanExport}"/><TextBlock Text="NATIVE DEFINITIONS ONLY" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Export edited BIN…" Command="{Binding ExportEditedCommand}" IsEnabled="{Binding CanExport}"/><TextBlock Text="SAVE A SEPARATE COPY" Style="{StaticResource RibbonCaption}"/></StackPanel>
   <StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Coverage report…" Command="{Binding SaveCoverageReportCommand}"/><TextBlock Text="DEFINITIONS AND GAPS" Style="{StaticResource RibbonCaption}"/></StackPanel><StackPanel Style="{StaticResource RibbonGroup}"><Button Content="Synthetic demo" Command="{Binding LoadDemoCommand}"/><TextBlock Text="LEARN THE EDITOR" Style="{StaticResource RibbonCaption}"/></StackPanel>
  </WrapPanel></TabItem>
  <TabItem Header="Notes &amp; coverage"><Grid Height="84" Margin="12,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding CoverageStatus}" FontWeight="SemiBold"/><TextBlock Text="{Binding AreaDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding AreaNeeded}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/></Grid></TabItem>
 </TabControl>
 <Border Grid.Row="2" Background="#FFF6E4" CornerRadius="4" Padding="8,5" Margin="0,0,0,7"><TextBlock Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></Border>
 <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="210" MinWidth="175"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#D8E3EC" BorderThickness="1" CornerRadius="7" Padding="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.4*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="TUNING AREAS" FontWeight="SemiBold" FontSize="10" Foreground="#60788D" Margin="8,3,0,5"/>
   <ListBox Grid.Row="1" x:Name="AreaNavigation" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Style="{StaticResource AreaList}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#60788D" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="12"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel Grid.Row="2" Margin="6,9,6,7"><TextBlock Text="TABLES IN THIS AREA" FontWeight="SemiBold" FontSize="10" Foreground="#60788D" Margin="0,0,0,5"/><TextBox Text="{Binding TableSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search loaded table names" Padding="6,4"/></StackPanel>
   <ListBox Grid.Row="3" x:Name="FieldNavigation" ItemsSource="{Binding VisibleFields}" SelectedItem="{Binding SelectedField}" Style="{StaticResource AreaList}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="11" ToolTip="{Binding Description}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid></Border>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent" ResizeDirection="Columns"/>
  <Grid Grid.Column="2" x:Name="EditorCanvas"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="GraphRow" Height="3*"/><RowDefinition x:Name="SplitRow" Height="7"/><RowDefinition x:Name="NumericRow" Height="2*"/></Grid.RowDefinitions>
   <Grid Margin="3,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TableTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FieldDescription}"/><TextBlock Grid.Column="1" Text="{Binding AxisCaption}" FontSize="10" Foreground="#60788D" VerticalAlignment="Center" MaxWidth="480" TextTrimming="CharacterEllipsis" Margin="12,0,3,0"/></Grid>
   <TabControl x:Name="TableViewTabs" Grid.Row="1" BorderThickness="0" Background="#EEF3F8"><TabItem Header="3D surface"><views:CalibrationSurface x:Name="SurfaceView" Data="{Binding Surface}"/></TabItem><TabItem Header="2D / first-row curve"><views:TelemetryChart Points="{Binding Curve}"/></TabItem></TabControl>
   <GridSplitter x:Name="GraphTableSplitter" Grid.Row="2" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#D5E1EA"/>
   <Border x:Name="NumericPanel" Grid.Row="3" Background="White" BorderBrush="#D5E1EA" BorderThickness="1" CornerRadius="5"><DockPanel><Border DockPanel.Dock="Top" Padding="8,4" Background="#E5EDF4"><TextBlock Text="NUMERIC TABLE · drag to select · Ctrl+C / Ctrl+V · Ctrl+Enter to save cells" FontSize="10" Foreground="#506A80"/></Border>
    <DataGrid x:Name="TableGrid" ItemsSource="{Binding TableRows}" IsReadOnly="{Binding CanEdit,Converter={StaticResource InverseBoolean}}" IsEnabled="{Binding Surface,Converter={StaticResource NullToBoolean}}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader" HeadersVisibility="All" RowHeaderWidth="56" RowHeight="25" ColumnHeaderHeight="26" GridLinesVisibility="All" Background="White" Foreground="#10283F" BorderThickness="0" FontFamily="Consolas" FontSize="11" PreviewKeyDown="TableGrid_KeyDown" SelectedCellsChanged="TableGrid_SelectedCellsChanged">
     <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Copy selection" Click="Copy_Click"/><MenuItem Header="Paste starting at cursor" Click="Paste_Click"/><Separator/><MenuItem Header="Select current row" Click="SelectRow_Click"/><MenuItem Header="Select current column" Click="SelectColumn_Click"/><MenuItem Header="Select all cells" Click="SelectAll_Click"/><Separator/><MenuItem Header="Cancel cell inputs" Command="{Binding DiscardCellsCommand}"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.RowHeaderStyle><Style TargetType="DataGridRowHeader"><Setter Property="Content" Value="{Binding RowLabel}"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGrid.RowHeaderStyle>
    </DataGrid>
   </DockPanel></Border>
   <Border Grid.RowSpan="4" Background="#F8FBFD" CornerRadius="7" Padding="32" BorderBrush="#D5E1EA" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedField}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" MaxWidth="700"><TextBlock Text="{Binding SelectedArea.Name}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="No matching table is loaded" FontSize="15" Foreground="#3D697F" Margin="0,8,0,15"/><TextBlock Text="{Binding AreaDescription}" TextWrapping="Wrap" FontSize="13"/><Border Background="#E8F0F6" Padding="14" CornerRadius="5" Margin="0,18,0,0"><TextBlock Text="{Binding AreaNeeded}" TextWrapping="Wrap" FontSize="12"/></Border><TextBlock Text="Load a matching definition to display tables in this area. Clear the table search if an existing item is hidden." TextWrapping="Wrap" FontSize="11" Foreground="#60788D" Margin="0,16,0,0"/><Button Content="Clear table search" Command="{Binding ClearTableSearchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
 <Expander Grid.Row="4" Header="Notes &amp; edit history" Margin="0,2,0,0" Padding="0" FontSize="10" IsExpanded="False"><Expander.Style><Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel><ToggleButton x:Name="HistoryToggle" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalAlignment="Left" Padding="5,1" MinHeight="19" FontSize="10" Background="Transparent" BorderThickness="0" ToolTip="Show or hide import notes and edit history"/><ContentPresenter x:Name="HistoryBody" ContentSource="Content" Visibility="Collapsed" Margin="0,2,0,0"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="HistoryBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Expander.Style><ListBox ItemsSource="{Binding Journal}" MaxHeight="64" BorderThickness="0" FontSize="10" Background="#E8EEF4"/></Expander>
</Grid>
</UserControl>
