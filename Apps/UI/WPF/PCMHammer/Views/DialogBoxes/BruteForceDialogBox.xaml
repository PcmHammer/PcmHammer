<Window x:Class="PCMHammer.Views.BruteForceDialogBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:PCMHammer.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="400"
        ResizeMode="NoResize"
        Title="Brute Force Unlock"
        Closing="BruteForceDialogBox_Closing">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" d:Text="Ready." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Labels" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <Label Content="Start:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Target="{Binding ElementName=StartKeyTextBox}" />
            <TextBox x:Name="StartKeyTextBox" Grid.Row="0" Grid.Column="1" 
                     d:Text="0000" Margin="5" Height="24" VerticalContentAlignment="Center"
                     CharacterCasing="Upper" FontFamily="Consolas"
                     Text="{Binding StartKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource HexConverter}}"/>

            <Label Content="End:" Grid.Row="0" Grid.Column="2" Margin="15,0,5,0" VerticalAlignment="Center" Target="{Binding ElementName=EndKeyTextBox}" />
            <TextBox x:Name="EndKeyTextBox" Grid.Row="0" Grid.Column="3" 
                     d:Text="FFFF" Margin="5" Height="24" VerticalContentAlignment="Center"
                     CharacterCasing="Upper" FontFamily="Consolas"
                     Text="{Binding EndKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource HexConverter}}"/>

            <Label Content="Speed:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Target="{Binding ElementName=SpeedComboBox}"/>
            <ComboBox x:Name="SpeedComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                      Margin="5" Height="24" VerticalContentAlignment="Center"
                      IsEditable="False"
                      ItemsSource="{Binding SpeedOptions}"
                      DisplayMemberPath="DisplayText"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding BruteForceSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Content="Algo sweep first" Grid.Row="2" Grid.ColumnSpan="4"
                      d:IsChecked="True" Margin="5,10"
                      IsChecked="{Binding AlgoSweepFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,5"
                        Visibility="{Binding BruteForceRunning, Converter={StaticResource BooleanToVisibility}}">
                <Label d:Content="Progress: 0000 / FFFF" Target="{Binding ElementName=ProgressBar}">
                    <Label.Content>
                        <MultiBinding StringFormat="Progress: {0:X4} / {1:X4}">
                            <Binding Path="CurrentKey" />
                            <Binding Path="EndKey" />
                        </MultiBinding>
                    </Label.Content>
                </Label>
                <ProgressBar x:Name="ProgressBar" d:Value="100" Height="22" Value="{Binding ProgressValue}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,5"
                        Visibility="{Binding BruteForceRunning, Converter={StaticResource BooleanToVisibility}}">
                <Label Content="Lockout Timer" Target="{Binding ElementName=LockoutTimerProgressBar}" />
                <ProgressBar x:Name="LockoutTimerProgressBar" Height="22" Minimum="0" Maximum="1" Value="{Binding LockoutProgress}"/>
            </StackPanel>

            <UniformGrid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Rows="1" Margin="0,15,0,5">
                <Button Content="Exit"
                        Width="96" 
                        HorizontalAlignment="Center" 
                        Command="{Binding ExitCommand}"/>
                <Button Content="Stop" 
                        Width="96" 
                        IsEnabled="{Binding BruteForceRunning}" 
                        HorizontalAlignment="Center" 
                        Command="{Binding StopCommand}"/>
                <Button Content="Start" 
                        Width="96" 
                        IsEnabled="{Binding BruteForceRunning, Converter={StaticResource InverseBoolean}}" 
                        HorizontalAlignment="Center" 
                        Command="{Binding StartCommand}"/>
            </UniformGrid>
            
        </Grid>
    </DockPanel>
</Window>