<Window x:Class="PCMHammer.Views.DevicePickerDialogBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCMHammer.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Title="Select Device">
    <StackPanel>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <GroupBox Header="Device Category">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SerialDeviceRadioButton"   GroupName="DeviceCategory" Content="Serial Device"  Margin="5"/>
                        <RadioButton x:Name="J2534DeviceRadioButton"    GroupName="DeviceCategory" Content="J2534 Device"   Margin="5"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Serial Device Options" IsEnabled="{Binding ElementName=SerialDeviceRadioButton, Path=IsChecked}">
                    <StackPanel>
                        <Label Content="Serial Port" 
                               Target="{Binding ElementName=SerialPortComboBox}"/>
                        <ComboBox x:Name="SerialPortComboBox" 
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding SerialPorts}" 
                                  SelectedItem="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Device Type" 
                               Target="{Binding ElementName=SerialDeviceTypeComboBox}"/>
                        <ComboBox x:Name="SerialDeviceTypeComboBox" 
                                  ItemsSource="{Binding SerialDevices}" 
                                  SelectedItem="{Binding SerialPortDeviceType, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="J2534 Device Options" IsEnabled="{Binding ElementName=J2534DeviceRadioButton, Path=IsChecked}">
                    <StackPanel>
                        <Label Content="Device Type" Target="{Binding ElementName=J2534DeviceTypeComboBox}"/>
                        <ComboBox x:Name="J2534DeviceTypeComboBox" ItemsSource="{Binding J2534Devices}" Text="Select..."/>
                    </StackPanel>
                </GroupBox>
                <CheckBox x:Name="Enable4xCommunication" Content="Enable 4x Communication" Margin="5,0,0,0"
                          IsChecked="{Binding Enable4xCommunication, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Auto Detect"   Margin="5,0,0,5" Width="120" Command="{Binding AutoDetectCommand}"/>
                    <Button Content="Test"          Margin="5,0,0,5" Width="120" Command="{Binding TestCommand}"/>
                    <Button Content="Cancel"        Margin="5,0,0,5" Width="120" Command="{Binding CancelCommand}" IsCancel="True"/>
                    <Button Content="OK"            Margin="5,0,0,5" Width="120" Command="{Binding AcceptCommand}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StatusBar Grid.Row="1">
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Stretch"/>
        </StatusBar>
    </StackPanel>
</Window>
