<Window x:Class="PCMHammer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCMHammer"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="Save _Results Log"    Command="{Binding SaveResultsLogCommand}"/>
                <MenuItem Header="Save _Debug Log"      Command="{Binding SaveDebugLogCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit"                Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Read Entire PCM"                     Command="{Binding ReadPCMCommand}"/>
                <MenuItem Header="_Verify Entire PCM"                   Command="{Binding VerifyPCMCommand}"/>
                <MenuItem Header="_Change VIN"                          Command="{Binding ChangeVINCommand}"/>
                <Separator Height="2" Margin="0,5,0,5"/>
                <MenuItem Header="Write _Parameters"                    Command="{Binding WriteParametersCommand}"/>
                <MenuItem Header="Write _OS, Calibration &amp; Boot"    Command="{Binding WriteOSCalibrationBootCommand}"/>
                <MenuItem Header="Write _Full Flash (Clone)"            Command="{Binding WriteFullFlashCloneCommand}"/>
                <Separator Height="2" Margin="0,5,0,5"/>
                <MenuItem Header="_Test File Checksums..."              Command="{Binding TestFileChecksumsCommand}"/>
                <MenuItem Header="Brute Force _Unlock..."               Command="{Binding BruteForceUnlockCommand}"/>
                <Separator Height="2" Margin="0,5,0,5"/>
                <MenuItem Header="_Halt Running Kernel"                  Command="{Binding HaltRunningKernelCommand}"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_User Defined Key"    Command="{Binding UserDefinedKeyCommand}"/>
                <MenuItem Header="_Settings"            Command="{Binding SettingsCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <GroupBox Header="Device">
                    <StackPanel>
                        <Button Content="_Select Device"        Command="{Binding ReadPCMCommand}" 
                                Margin="5"/>
                        <Button Content="Re-_Initialize Device" Command="{Binding ReInitializeDeviceCommand}" 
                                Margin="5"/>
                    </StackPanel>
                </GroupBox>
                <Separator Margin="0,16" Height="0"/>
                <GroupBox Header="Operations" Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel>
                        <Button Content="Read _Properties"      Command="{Binding ReadPropertiesCommand}" 
                                Margin="5"/>
                        <Button Content="Read P_CM"             Command="{Binding ReadPCMCommand}" 
                                Margin="5"/>
                        <Button Content="_Write PCM"            Command="{Binding WritePCMCommand}" 
                                Margin="5"/>
                        <Button Content="T_est Write"           Command="{Binding TestWriteCommand}" 
                                Margin="5"/>
                        <Button Content="_Verify PCM"           Command="{Binding VerifyPCMCommand}" 
                                Margin="5"/>
                    </StackPanel>
                </GroupBox>
                <Separator Margin="0,16" Height="0"/>
                <GroupBox Header="Kernel" Grid.Row="2">
                    <StackPanel>
                        <Button Content="_Halt Running Kernel"  Command="{Binding HaltRunningKernelCommand}" 
                            Margin="5"/>
                        <Button Content="_Cancel"               Command="{Binding CancelCurrentCommand}" 
                            Margin="5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            
            <TabControl Grid.Column="1" Margin="8,0,0,0">
                <TabItem Header="Results">
                    <TextBox x:Name="ResultsLogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Visible"/>
                </TabItem>
                <TabItem Header="Help">
                    <WebBrowser x:Name="HelpWebBrowser"/>
                </TabItem>
                <TabItem Header="Credits">
                    <WebBrowser x:Name="CreditsWebBrowser"/>
                </TabItem>
                <TabItem Header="Debug">
                    <TextBox x:Name="DebugLogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Visible"/>
                </TabItem>
            </TabControl>
        </Grid>
        
        <StatusBar Grid.Row="2" HorizontalContentAlignment="Stretch">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0" HorizontalAlignment="Stretch">
                <TextBlock x:Name="ActivityTextBlock" Text="Ready" HorizontalAlignment="Stretch" 
                           VerticalAlignment="Center"/>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RetryCountTextBlock" Text="Retries: 0" 
                               VerticalAlignment="Center"/>
                    <Separator Margin="10,0"/>
                    
                    <TextBlock x:Name="KbpsTextBlock" Text="0 kbps" VerticalAlignment="Center"/>
                    <Separator Margin="10,0"/>

                    <ProgressBar x:Name="ProgressBar" Width="150" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProgressBarPercentTextBlock" Text="0%" Margin="6,0" VerticalAlignment="Center"/>
                    <Separator Margin="10,0"/>

                    <TextBlock x:Name="TimeRemainingTextBlock" Text="00:00 Remaining" VerticalAlignment="Center" Margin="0,0,5,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
