<Window x:Class="PCMHammer.Views.DevicePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCMHammer.Views"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        SizeToContent="WidthAndHeight"
        Title="Select Device">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <GroupBox Header="Device Category">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SerialDeviceRadioButton" GroupName="DeviceCategory" Content="Serial Device" Margin="5"/>
                    <RadioButton x:Name="J2534DeviceRadioButton" GroupName="DeviceCategory" Content="J2534 Device" Margin="5"/>
                </StackPanel>
            </GroupBox>
            <Separator Margin="0,5" Height="0"/>
            <GroupBox Header="Serial Device Options" IsEnabled="{Binding ElementName=SerialDeviceRadioButton, Path=IsChecked}">
                <StackPanel>
                    <Label Content="Serial Port" Target="{Binding ElementName=SerialPortComboBox}"/>
                    <ComboBox x:Name="SerialPortComboBox"/>
                    <Label Content="Device Type" Target="{Binding ElementName=SerialDeviceTypeComboBox}"/>
                    <ComboBox x:Name="SerialDeviceTypeComboBox"/>
                </StackPanel>
            </GroupBox>
            <Separator Margin="0,5" Height="0"/>
            <GroupBox Header="J2534 Device Options" IsEnabled="{Binding ElementName=J2534DeviceRadioButton, Path=IsChecked}">
                <StackPanel>
                    <Label Content="Device Type" Target="{Binding ElementName=J2534DeviceTypeComboBox}"/>
                    <ComboBox x:Name="J2534DeviceTypeComboBox"/>
                </StackPanel>
            </GroupBox>
            <Separator Margin="0,5" Height="0"/>
            <CheckBox x:Name="Enable4xCommunication" Content="Enable 4x Communication" Margin="5,0,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Auto Detect"   Width="75" Margin="5"/>
                <Button Content="Test"          Width="75" Margin="5"/>
                <Button Content="Cancel"        Width="75" Margin="5"/>
                <Button Content="OK"            Width="75" Margin="5" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
